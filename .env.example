# Copy to .env. Replace both passwords/secrets; never commit .env.
POSTGRES_USER=flowpilot
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=flowpilot
DATABASE_URL=postgresql://flowpilot:replace-with-a-long-local-password@localhost:5432/flowpilot?schema=public
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000

# Raw server-side AES-256 keys, never NEXT_PUBLIC_ or database values.
# For LOCAL development only: npm run integrations:setup:local
INTEGRATION_ACTIVE_KEY_ID=
INTEGRATION_ENCRYPTION_KEYS=
# Disabled by default. Enable only for deliberate loopback test verification.
INTEGRATION_TEST_ADAPTER_ENABLED=false
INTEGRATION_TEST_ISSUER_KEY=

# Exact HTTPS origins permitted for HTTP actions/credential verification (JSON).
# Empty denies all outbound actions. No wildcards, paths, or private destinations.
HTTP_ACTION_ALLOWED_ORIGINS=[]
# Origins whose operators guarantee suitable Idempotency-Key behavior for writes.
# Non-GET retries also require retrySafe=true in the node; default denies them.
HTTP_IDEMPOTENT_ORIGINS=[]

# Google OAuth web application credentials (server-only; never commit values).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match this path on BETTER_AUTH_URL and Google Console registration.
# Loopback HTTP is development-only; production requires HTTPS.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Additionally approve these origins in HTTP_ACTION_ALLOWED_ORIGINS when enabling Google:
# https://oauth2.googleapis.com, https://www.googleapis.com,
# https://sheets.googleapis.com, https://gmail.googleapis.com
# Enable Google Sheets API and Gmail API in the OAuth project's Google Cloud Console.
# Gmail defaults to blocked; explicit operator-approved, consented recipients only.
GOOGLE_GMAIL_SEND_ENABLED=false
GOOGLE_GMAIL_ALLOWED_RECIPIENTS=[]

# Task 5D: server-only platform OpenAI key. Never NEXT_PUBLIC_ or an ambient SDK key.
FLOWPILOT_OPENAI_API_KEY=
# Operator JSON allowlist; start from config/ai-models.example.json, update model
# IDs/capabilities and CURRENT pricing before enabling. No model is enabled by default.
FLOWPILOT_AI_MODELS_JSON=[]
FLOWPILOT_AI_DEFAULT_MODEL=
# Exact https://api.openai.com must also be approved in HTTP_ACTION_ALLOWED_ORIGINS.
# Workspace budgets default to zero. Platform ceilings below are micro-USD.
FLOWPILOT_AI_MAX_DAILY_MICROS=1000000
FLOWPILOT_AI_MAX_MONTHLY_MICROS=5000000
# DO NOT set test labels in a live environment. Tests use isolated fixture processes.

# Task 5E: controlled developer-owned Meta test account only; default off.
# Server-only secrets: never put these in NEXT_PUBLIC_* variables.
META_WHATSAPP_DEVELOPER_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Generate a separate stable random key (32+ chars). Keep stable across App Secret / vault rotations.
# Rotating this key requires an explicit suppression/consent migration; never silently replace it.
META_RECIPIENT_HASH_KEY=
# v26.0 verified against the official Meta changelog on 2026-10-29.
META_GRAPH_API_VERSION=v26.0
# JSON pairs of operator-approved developer test assets; WABA now identifies the Messaging account.
META_WHATSAPP_TEST_ASSETS=[]
# Exact international digits, no '+'. No recipient is allowed by default.
META_WHATSAPP_TEST_RECIPIENTS=[]
# Add exact https://graph.facebook.com to HTTP_ACTION_ALLOWED_ORIGINS when enabling.
# META_TEST_LABEL=MOCK is for explicit loopback fixture processes only; it does not mock requests.

# Task 6A: TEST billing only. sk_live_* keys are refused by the application.
PAYSTACK_TEST_ENABLED=false
PAYSTACK_SECRET_KEY=
# Logical tier -> interval -> provider TEST plan code. Amount/currency/interval are verified server-side.
PAYSTACK_TEST_PLAN_CODES_JSON={}
# Optional full four-plan catalog override; see config/billing-plans.example.json.
# FLOWPILOT_BILLING_CATALOG_JSON=
# Add exact https://api.paystack.co to HTTP_ACTION_ALLOWED_ORIGINS to enable test API calls.
# PAYSTACK_TEST_LABEL=MOCK labels explicit loopback fixture processes only; it does not mock HTTP.

# Task 6B runtime guard: Next NODE_ENV=production also runs local builds;
# FLOWPILOT_ENV=production activates the additional deployment requirements.
FLOWPILOT_ENV=development
DB_POOL_MAX=5
API_USER_RATE_PER_MINUTE=600
# Migrations use a dedicated direct/session-compatible DDL connection when configured.
# DIRECT_DATABASE_URL=
# Required 32+ character dedicated token in production; never expose in NEXT_PUBLIC.
OPERATIONS_TOKEN=
# Production public registration stays disabled pending verified-email/recovery delivery.
AUTH_REGISTRATION_ENABLED=false
# Optional per-process worker metadata (no secrets); default ID is random.
# FLOWPILOT_WORKER_ID=
# WORKER_HEALTH_FILE=/tmp/flowpilot-worker-health.json
# Operations backup/restore: separate, least-privilege URLs and a dedicated 32-byte
# base64 encryption key held separately from archives. Never restore to DATABASE_URL.
# BACKUP_DATABASE_URL=
# BACKUP_OUTPUT=/protected/backups/flowpilot-YYYYMMDD.backup.enc
# BACKUP_ENCRYPTION_KEY=
# BACKUP_KEY_ID=
# RESTORE_DATABASE_URL=
# RESTORE_CONFIRM_DATABASE=flowpilot_restore_dr_YYYYMMDD
# BACKUP_INPUT=/protected/backups/flowpilot-YYYYMMDD.backup.enc
# PGSSLROOTCERT=/protected/postgres-root-ca.pem
# PG_TOOL_CONTAINER=flow-db-1  # Local disposable recovery test only; native clients in production.
