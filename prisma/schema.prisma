generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships WorkspaceMember[]
  platformAdministrator PlatformAdministrator?
}
model Session {
  id String @id
  token String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
}
model Workspace {
  id String @id @default(cuid())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members WorkspaceMember[]
  subscription Subscription?
  workflows Workflow[]
  templateInstallations TemplateInstallation[]
  integrations WorkspaceIntegration[]
  integrationEvents IntegrationAuditEvent[]
  whatsappConnections WhatsAppConnection[]
  billingPayments BillingPayment[]
  billingCheckouts BillingCheckout[]
  billingEvents BillingEvent[]
  billingAudits BillingAudit[]
  executionLeases ExecutionLease[]
  quotaEntries QuotaEntry[]
  aiBudget AIWorkspaceBudget?
  aiUsage AIUsage[]
  aiEvents AIBudgetEvent[]
}
model WorkspaceMember {
  id String @id @default(cuid())
  workspaceId String
  userId String
  role WorkspaceRole @default(VIEWER)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId])
}
model SubscriptionPlan {
  id String @id @default(cuid())
  code String @unique
  name String
  monthlyPriceCents Int
  currency String @default("USD")
  createdAt DateTime @default(now())
  subscriptions Subscription[]
}
model Subscription {
  id String @id @default(cuid())
  workspaceId String @unique
  planId String
  status SubscriptionStatus @default(TRIALING)
  currentPeriodEnd DateTime?
  provider String?
  mode String?
  providerCode String? @unique
  customerCode String?
  providerPlanCode String?
  interval String @default("monthly")
  amountMinor Int @default(0)
  currency String @default("NGN")
  paidVerifiedAt DateTime?
  lastPaidAt DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  credentialCiphertext String?
  lastReconciledAt DateTime?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@index([planId])
  @@unique([providerCode,workspaceId],map:"billing_subscription_workspace_code")
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}
enum NodeStatus {
  SUCCEEDED
  FAILED
  SKIPPED
}
model Workflow {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  draft Json
  editor Json @default("{}")
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions WorkflowVersion[]
  runs WorkflowRun[]
  installation TemplateInstallation?
  internalKind String?
  @@unique([workspaceId, internalKind])
  enabled Boolean @default(true)
  archivedAt DateTime?
  webhooks Webhook[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt])
}
model WorkflowVersion {
  id String @id @default(cuid())
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  number Int
  definition Json
  editor Json @default("{}")
  publishedAt DateTime @default(now())
  runs WorkflowRun[]
  webhooks Webhook[]
  @@unique([workflowId, number])
  @@unique([id, workflowId])
}
model WorkflowRun {
  id String @id
  workflowId String
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionId String
  version WorkflowVersion @relation(fields: [versionId, workflowId], references: [id, workflowId], onDelete: Cascade)
  requestedBy String
  idempotencyKey String
  requestHash String
  payload String
  status RunStatus @default(QUEUED)
  input Json
  output Json?
  error String?
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  nodes NodeRun[]
  attempts HttpAttempt[]
  aiUsage AIUsage[]
  whatsappMessages WhatsAppMessage[]
  whatsappDeliveries WhatsAppEventRun[]
  executionLease ExecutionLease?
  webhookDelivery WebhookDelivery?
  @@unique([workflowId, idempotencyKey])
  @@index([status, createdAt])
}
model NodeRun {
  id String @id @default(cuid())
  runId String
  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId String
  type String
  position Int
  status NodeStatus
  input Json
  output Json?
  error String?
  startedAt DateTime?
  finishedAt DateTime
  @@unique([runId, nodeId])
  @@index([runId, position])
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
model PlatformAdministrator {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model AutomationTemplate {
  id String @id @default(cuid())
  slug String @unique
  draft Json
  revision Int @default(1)
  status TemplateStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions AutomationTemplateVersion[]
  @@index([status])
}
model AutomationTemplateVersion {
  id String @id @default(cuid())
  templateId String
  template AutomationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  number Int
  content Json
  publishedAt DateTime @default(now())
  installations TemplateInstallation[]
  @@unique([templateId, number])
  @@unique([id, templateId])
}
model TemplateInstallation {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowId String @unique
  workflow Workflow @relation(fields: [workflowId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  templateId String
  templateVersionId String
  version AutomationTemplateVersion @relation(fields: [templateVersionId, templateId], references: [id, templateId], onDelete: Restrict)
  requestedBy String
  idempotencyKey String
  nodeMap Json
  createdAt DateTime @default(now())
  @@unique([workspaceId, idempotencyKey])
  @@unique([workflowId, workspaceId])
  @@index([templateVersionId])
  @@index([workspaceId, createdAt])
}

enum ProviderState {
  AVAILABLE
  COMING_SOON
  TEST_ONLY
  DISABLED
}
enum IntegrationStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}
enum IntegrationEventKind {
  CREATED
  LABEL_UPDATED
  AUTHENTICATION_STARTED
  AUTHENTICATION_SUCCEEDED
  HEALTH_VERIFIED
  REFRESHED
  EXPIRED
  REVOKED
  DELETED
  FAILED
  KEY_ROTATED
}
model IntegrationProvider {
  id String @id
  name String
  description String
  authMethod String
  requiredScopes String[]
  capabilities String[]
  configurationSchema Json
  state ProviderState @default(COMING_SOON)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  connections WorkspaceIntegration[]
}
model WorkspaceIntegration {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  providerId String
  provider IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  connectionKey String? @default("primary")
  label String
  status IntegrationStatus @default(DISCONNECTED)
  revision Int @default(1)
  scopes String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastVerifiedAt DateTime?
  revokedAt DateTime?
  deletedAt DateTime?
  lastErrorCode String?
  accountSubject String?
  accountEmail String?
  googleAttempts GoogleOAuthAttempt[]
  authAttemptId String?
  authInitiatedBy String?
  authStateHash String?
  authStateCiphertext String?
  authExpiresAt DateTime?
  whatsapp WhatsAppConnection?
  credential IntegrationCredential?
  events IntegrationAuditEvent[]
  @@unique([workspaceId, providerId, connectionKey])
  @@unique([id, workspaceId, providerId])
  @@index([workspaceId, deletedAt])
}
model IntegrationCredential {
  id String @id
  integrationId String @unique
  workspaceId String
  providerId String
  integration WorkspaceIntegration @relation(fields: [integrationId, workspaceId, providerId], references: [id, workspaceId, providerId], onDelete: Cascade)
  ciphertext String
  keyId String
  generation Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issuedAt DateTime
  expiresAt DateTime
  refreshedAt DateTime?
  rotatedAt DateTime?
  revokedAt DateTime?
  destroyedAt DateTime?
  @@unique([integrationId, workspaceId, providerId])
}
model IntegrationAuditEvent {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationId String
  providerId String
  integration WorkspaceIntegration @relation(fields: [integrationId, workspaceId, providerId], references: [id, workspaceId, providerId], onDelete: Cascade)
  actorId String
  kind IntegrationEventKind
  status IntegrationStatus
  revision Int
  code String?
  createdAt DateTime @default(now())
  @@index([workspaceId, integrationId, createdAt])
}

model Webhook {
  id String @id
  workflowId String
  workflow Workflow @relation(fields:[workflowId], references:[id], onDelete:Cascade)
  versionId String
  version WorkflowVersion @relation(fields:[versionId,workflowId],references:[id,workflowId],onDelete:Cascade)
  createdBy String
  enabled Boolean @default(true)
  revokedAt DateTime?
  revision Int @default(1)
  ciphertext String
  keyId String
  createdAt DateTime @default(now())
  deliveries WebhookDelivery[]
  audits WebhookAudit[]
  rates WebhookRate[]
  @@index([workflowId])
}
model WebhookDelivery {
  id String @id @default(cuid())
  webhookId String
  webhook Webhook @relation(fields:[webhookId], references:[id], onDelete:Cascade)
  deliveryId String
  runId String @unique
  run WorkflowRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([webhookId,deliveryId])
}
model WebhookAudit {
  id String @id @default(cuid())
  webhookId String
  webhook Webhook @relation(fields:[webhookId],references:[id],onDelete:Cascade)
  code String
  createdAt DateTime @default(now())
  @@index([webhookId,createdAt])
}
model WebhookRate {
  webhookId String @id
  webhook Webhook @relation(fields:[webhookId],references:[id],onDelete:Cascade)
  bucket BigInt
  count Int
}
model HttpAttempt {
  id String @id
  runId String
  run WorkflowRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  nodeId String
  number Int
  state String
  statusCode Int?
  error String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@unique([runId,nodeId,number])
}

model GoogleOAuthAttempt {
 id String @id
 integrationId String
 integration WorkspaceIntegration @relation(fields:[integrationId],references:[id],onDelete:Cascade)
 stateHash String @unique
 createdAt DateTime @default(now())
 expiresAt DateTime
 consumedAt DateTime?
 @@index([integrationId])
}

enum AIRequestStatus {
 RESERVED
 RUNNING
 SUCCEEDED
 FAILED
 REFUSED
 UNKNOWN
 RECONCILED
}
model AIWorkspaceBudget {
 workspaceId String @id
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 dailyLimitMicros BigInt @default(0)
 monthlyLimitMicros BigInt @default(0)
 revision Int @default(1)
 updatedAt DateTime @updatedAt
}
model AIUsage {
 id String @id
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 runId String
 run WorkflowRun @relation(fields:[runId],references:[id],onDelete:Cascade)
 nodeId String
 requestedBy String
 source String
 provider String
 mode String
 modelId String
 model String
 status AIRequestStatus @default(RESERVED)
 revision Int @default(1)
 inputTokenBound Int
 maxOutputTokens Int
 inputTokens Int?
 outputTokens Int?
 totalTokens Int?
 usageDetails Json?
 reservedMicros BigInt
 accountedMicros BigInt
 estimatedCostMicros BigInt?
 accountingSource String @default("RESERVATION")
 pricing Json
 day String
 month String
 requestId String?
 responseId String?
 error String?
 resultCiphertext String?
 resultExpiresAt DateTime?
 reconciledBy String?
 reconciliation Json?
 reconciledAt DateTime?
 createdAt DateTime @default(now())
 finishedAt DateTime?
 @@unique([runId,nodeId])
 @@index([workspaceId,day])
 @@index([workspaceId,month])
}
model AIBudgetEvent {
 id String @id @default(cuid())
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 actorId String
 usageId String?
 kind String
 data Json
 createdAt DateTime @default(now())
 @@index([workspaceId,createdAt])
}

model WhatsAppConnection {
 id String @id
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 integrationId String @unique
 providerId String @default("whatsapp-business")
 integration WorkspaceIntegration @relation(fields:[integrationId,workspaceId,providerId],references:[id,workspaceId,providerId],onDelete:Cascade)
 @@unique([integrationId,workspaceId,providerId])
 messagingAccountId String
 legacyWabaId String
 businessName String
 graphVersion String
 mode String @default("DEVELOPER_TEST")
 dailyLimit Int @default(0)
 createdBy String
 createdAt DateTime @default(now())
 phones WhatsAppPhone[]
 subscriptions WhatsAppSubscription[]
 @@unique([id,workspaceId])
}
model WhatsAppPhone {
 id String @id
 workspaceId String
 connectionId String
 connection WhatsAppConnection @relation(fields:[connectionId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 providerPhoneId String @unique
 displayLast4 String
 verifiedName String
 enabled Boolean @default(true)
 contacts WhatsAppContact[]
 messages WhatsAppMessage[]
 events WhatsAppEvent[]
 subscriptions WhatsAppSubscription[]
 @@unique([id,workspaceId])
}
model WhatsAppContact {
 id String @id
 workspaceId String
 phoneId String
 phone WhatsAppPhone @relation(fields:[phoneId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 recipientHash String
 last4 String
 lastInboundAt DateTime?
 consentAt DateTime?
 consentSource String?
 optedOutAt DateTime?
 updatedAt DateTime @updatedAt
 @@unique([phoneId,recipientHash])
 @@unique([id,workspaceId])
}
model WhatsAppMessage {
 id String @id
 workspaceId String
 phoneId String
 phone WhatsAppPhone @relation(fields:[phoneId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 runId String
 run WorkflowRun @relation(fields:[runId],references:[id],onDelete:Cascade)
 nodeId String
 recipientHash String
 recipientLast4 String
 kind String
 templateId String?
 providerMessageId String? @unique
 state String @default("RESERVED")
 error String?
 createdAt DateTime @default(now())
 acceptedAt DateTime?
 reviewedAt DateTime?
 reviewedBy String?
 statusAt DateTime?
 attempts WhatsAppAttempt[]
 statuses WhatsAppStatus[]
 @@unique([runId,nodeId])
 @@unique([id,workspaceId])
 @@index([workspaceId,createdAt])
}
model WhatsAppAttempt {
 id String @id
 workspaceId String
 messageId String
 message WhatsAppMessage @relation(fields:[messageId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 number Int
 state String
 statusCode Int?
 error String?
 createdAt DateTime @default(now())
 finishedAt DateTime?
 @@unique([messageId,number])
}
model WhatsAppEvent {
 id String @id
 workspaceId String
 phoneId String
 phone WhatsAppPhone @relation(fields:[phoneId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 dedupKey String
 kind String
 providerId String
 providerAt DateTime
 ciphertext String?
 expiresAt DateTime
 state String @default("PENDING")
 error String?
 createdAt DateTime @default(now())
 processedAt DateTime?
 deliveries WhatsAppEventRun[]
 @@unique([phoneId,dedupKey])
 @@unique([id,workspaceId])
 @@index([state,createdAt])
}
model WhatsAppStatus {
 id String @id
 workspaceId String
 messageId String
 message WhatsAppMessage @relation(fields:[messageId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 eventId String @unique
 state String
 providerAt DateTime
 errorCode String?
 createdAt DateTime @default(now())
}
model WhatsAppSubscription {
 id String @id
 workspaceId String
 connectionId String
 connection WhatsAppConnection @relation(fields:[connectionId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 phoneId String
 phone WhatsAppPhone @relation(fields:[phoneId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 workflowId String
 versionId String
 createdBy String
 enabled Boolean @default(true)
 createdAt DateTime @default(now())
 @@unique([phoneId,workflowId])
}
model WhatsAppEventRun {
 id String @id
 workspaceId String
 eventId String
 event WhatsAppEvent @relation(fields:[eventId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 workflowId String
 runId String @unique
 run WorkflowRun @relation(fields:[runId],references:[id],onDelete:Cascade)
 @@unique([eventId,workflowId])
}

model BillingCheckout {
 payments BillingPayment[]
 @@unique([id,workspaceId])
 @@unique([subscriptionCode,workspaceId],map:"billing_checkout_workspace_code")
 id String @id
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 requestedBy String
 emailHash String
 idempotencyKey String
 requestHash String
 reference String @unique
 tier String
 interval String
 amountMinor Int
 currency String @default("NGN")
 providerPlanCode String
 providerPlanId Int
 status String @default("INITIALIZING")
 subscriptionAttemptedAt DateTime?
 subscriptionCode String? @unique
 providerTransactionId String? @unique
 customerCode String?
 customerId Int?
 paidAt DateTime?
 urlCiphertext String?
 error String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 lastReconciledAt DateTime?
 @@unique([workspaceId,idempotencyKey])
 @@index([workspaceId,createdAt])
}
model BillingEvent {
 id String @id
 digest String @unique
 workspaceId String?
 workspace Workspace? @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 kind String
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 reference String?
 subscriptionCode String?
 status String @default("PENDING")
 error String?
 createdAt DateTime @default(now())
 processedAt DateTime?
 @@index([status,createdAt])
}
model BillingAudit {
 id String @id
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 actorId String
 code String
 source String
 reference String?
 fromStatus String?
 toStatus String?
 createdAt DateTime @default(now())
 @@index([workspaceId,createdAt])
}
model BillingPayment {
 reference String @id
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 providerTransactionId String @unique
 subscriptionCode String?
 checkoutId String
 checkout BillingCheckout @relation(fields:[checkoutId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 amountMinor Int
 currency String
 paidAt DateTime
 periodEnd DateTime
 source String
 createdAt DateTime @default(now())
 @@index([workspaceId,paidAt])
}
model QuotaEntry {
 id String @id
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 period String
 metric String
 key String
 amount BigInt
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([workspaceId,metric,key])
 @@index([workspaceId,period,metric])
}

model ExecutionLease {
 releasedAt DateTime?
 expiresAt DateTime @default(dbgenerated("(now() + '00:01:30'::interval)"))
 runId String @id
 run WorkflowRun @relation(fields:[runId],references:[id],onDelete:Cascade)
 workspaceId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 @@index([workspaceId])
}

model WorkerHeartbeat {
 id String @id
 status String
 startedAt DateTime @default(now())
 lastSeenAt DateTime @default(now())
 lastRunId String?
 errorCode String?
 @@index([lastSeenAt])
}
model OperationalMetric {
 bucket DateTime
 route String
 status Int
 count Int @default(1)
 @@id([bucket,route,status])
 @@index([bucket])
}
