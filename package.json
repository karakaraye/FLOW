{
  "name": "flowpilot-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "test:database": "tsx --test tests/database.test.ts",
    "test:public": "tsx --test tests/public.test.ts",
    "test:auth": "tsx --test tests/foundation.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:env": "node scripts/setup-env.mjs",
    "worker": "tsx scripts/worker.ts",
    "test:engine": "tsx --test tests/engine*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "test:builder": "tsx --test tests/builder*.test.ts",
    "db:seed:templates": "tsx scripts/seed-templates.ts",
    "catalog:admin": "tsx scripts/catalog-admin.ts",
    "test:templates": "tsx --test tests/templates*.test.ts",
    "integrations:setup:local": "node scripts/setup-integrations.mjs",
    "db:seed:providers": "tsx scripts/seed-providers.ts",
    "test:integrations": "tsx --test tests/integrations*.test.ts",
    "ops:backup": "node scripts/operations/backup.mjs",
    "ops:restore": "node scripts/operations/restore.mjs",
    "ops:check": "tsx scripts/operations/check-runtime.ts",
    "test:security": "tsx --test tests/hardening.test.ts tests/recovery.test.ts tests/worker-shutdown.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "google-auth-library": "11.3.1",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.13",
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "openai": "7.45.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
