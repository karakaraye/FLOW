{
  # Explicit time limits; preserve provider raw bodies (no JSON rewriting).
  servers {
    timeouts {
      read_header 10s
      read_body 30s
      write 180s
      idle 60s
    }
  }
}
{$PUBLIC_HOST} {
  encode zstd gzip
  reverse_proxy web:3000 {
    header_up X-FlowPilot-Client-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Host {$PUBLIC_HOST}
    header_up X-Forwarded-Proto https
  }
  # Intentionally no access log: OAuth/payment query strings must not enter logs.
}
